# ─────────────────────────────────────────────────────────────
# AndyCampers · Landing P70 · variables de entorno
# Copiá este archivo como .env.local (desarrollo) y cargá las mismas
# variables en Netlify → Site configuration → Environment variables.
# Nada de esto se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Sitio ────────────────────────────────────────────────────
# Dejalo vacío mientras sea demo (cartel rojo DEMO + noindex).
# Para publicar: false (el build falla si quedan datos pendientes).
NEXT_PUBLIC_DEMO=
# En Netlify la define el build con $URL (ver netlify.toml). Para otro hosting:
# NEXT_PUBLIC_SITE_URL=https://andycampers.com.ar

# ── Videos del selector (CDN) ────────────────────────────────
# Base pública del CDN donde están los 16 videos y sus posters, sin barra final.
# Ej. Cloudflare R2 con dominio propio: https://media.andycampers.com.ar
# Ej. Bunny CDN: https://andycampers.b-cdn.net
# Vacío = se sirven desde /public/media (solo para desarrollo y la demo).
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── Google Sheets (planilla de leads) ────────────────────────
# Email de la service account (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la service account, en UNA línea con \n literales.
# Ej: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# ID de la planilla: lo que va entre /d/ y /edit en la URL
GOOGLE_SHEET_ID=
# Nombre de la pestaña (opcional, por defecto "Leads")
GOOGLE_SHEET_TAB=Leads

# ── Email (Resend) · respaldo de avisos y resumen semanal ────
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend
RESEND_FROM="AndyCampers Web <web@andycampers.com.ar>"
# Destinatario(s) de los avisos, separados por coma
NOTIFY_EMAIL=

# ── WhatsApp Business Cloud API (Meta) ───────────────────────
# Dejalo en false hasta que Meta apruebe la plantilla: mientras tanto
# los leads calientes se avisan por email.
WHATSAPP_ENABLED=false
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NAME=lead_caliente
WA_TEMPLATE_LANG=es_AR
# Número de Andrés que recibe el aviso, formato internacional sin +
WA_RECIPIENT=5493415641103
# Versión de la Graph API (opcional)
WA_API_VERSION=v21.0

# ── Cloudflare Turnstile (antispam) ──────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Envíos máximos por IP cada 10 minutos (opcional)
RATE_LIMIT_MAX=5

# ── Resumen semanal (lunes 9:00, hora Argentina) ─────────────
# Un texto largo y aleatorio. Ej: openssl rand -hex 32
CRON_SECRET=

# ── Analítica ────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
